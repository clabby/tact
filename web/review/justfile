review_directory := justfile_directory()
repository_directory := review_directory + "/../.."

build:
    cd "{{ review_directory }}" && bun run build

dev:
    cd "{{ review_directory }}" && bun run dev

# Build and link these assets into the path used by development Tact builds.
install-dev: build
    #!/usr/bin/env bash
    set -euo pipefail

    review_directory="{{ review_directory }}"
    repository_directory="{{ repository_directory }}"
    version=$(
        cargo metadata \
            --manifest-path "$repository_directory/Cargo.toml" \
            --no-deps \
            --format-version 1 |
            bun -e '
                const metadata = await Bun.stdin.json();
                const tact = metadata.packages.find((candidate) => candidate.name === "tact");
                if (!tact) throw new Error("tact package not found");
                process.stdout.write(tact.version);
            '
    )

    if [[ -n "${TACT_HOME:-}" ]]; then
        tact_directory="$TACT_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        tact_directory="$HOME/.tact"
    elif [[ -n "${USERPROFILE:-}" ]]; then
        tact_directory="$USERPROFILE/.tact"
    else
        echo "could not determine the Tact directory; set TACT_HOME" >&2
        exit 1
    fi

    destination="$tact_directory/review/v$version"
    mkdir -p "$(dirname "$destination")"

    if [[ -e "$destination" && ! -L "$destination" ]]; then
        echo "refusing to replace non-symlink review assets at $destination" >&2
        exit 1
    fi

    rm -f -- "$destination"
    ln -s -- "$review_directory/dist" "$destination"
    printf 'Installed development review assets at %s\n' "$destination"
