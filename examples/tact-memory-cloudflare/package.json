{
  "name": "tact-memory-cloudflare",
  "private": true,
  "scripts": {
    "build": "worker-build --release",
    "credentials:local": "bun run scripts/credentials.ts local",
    "credentials:push": "bun run scripts/credentials.ts push",
    "dev": "bun run credentials:local && wrangler dev",
    "migrate:local": "bun run scripts/activate.ts local",
    "migrate:remote": "bun run scripts/activate.ts remote",
    "deploy": "bun run scripts/activate.ts deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir bundled",
    "test": "bun test scripts",
    "test:indexed": "bun run scripts/indexed.ts"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
